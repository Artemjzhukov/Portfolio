# --- Qdrant / эмбеддинги (общие с core/database.py) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=history_docs
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- LLM для оценки ---
# openai: strict JSON Schema + Vision OCR (gpt-4o). ollama: локальный OpenAI-совместимый сервер.
# OpenRouter: LLM_PROVIDER=openai + LLM_BASE_URL=https://openrouter.ai/api/v1
#             + OPENAI_API_KEY=sk-or-... + OPENAI_EVAL_MODEL=openai/gpt-4o
#             (если модель не поддерживает Structured Outputs: LLM_STRICT_JSON=false)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
LLM_BASE_URL=
LLM_STRICT_JSON=true
OPENAI_EVAL_MODEL=gpt-4o
OPENAI_OCR_MODEL=gpt-4o
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3:8b

# --- Оценка / OCR ---
MIN_EXTRACTED_CHARS=40
OCR_CONFIDENCE_THRESHOLD=0.6
MAX_FILE_MB=25
CONSISTENCY_VOTES=1
CRITERIA_DIR=data/criteria

# --- RAG ---
RAG_TOP_K=5
RAG_MIN_SCORE=0.35

# --- API ---
# Shared secret для n8n; пусто = авторизация по X-API-Key выключена
API_KEY=

# SQLite-хранилище джоб (async/idempotency/аудит)
JOBS_DB_PATH=assessment_jobs.db

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
